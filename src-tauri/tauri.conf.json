{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workshop",
  "version": "1.0.0",
  "identifier": "dev.akshitarora.workshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "workshop",
        "width": 1200,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNUIzODcxODkzMjY1NUEKUldSYVpUS0pjVGhiTTNLZks5RlMzVGtZOC9jZlVEUXUrTmxPSXh3Sk1EdEZTL0dDOExxb050a3MK",
      "endpoints": [
        "https://github.com/akshit-arora/workshop/releases/latest/download/latest.json"
      ]
    }
  }
}
