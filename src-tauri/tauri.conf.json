{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "workshop",
  "version": "0.1.0",
  "identifier": "dev.akshitarora.workshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "workshop",
        "width": 1200,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/akshit-arora/workshop/releases/download/v__VERSION__/latest.json"
      ],
      "pubkey": "untrusted comment: minisign public key: 8B989177EBA6817E\nRWR+gabrd5GYi2USD88Oaq6gzgiOL5rdO65jYX0OM5n25+v9FIUrNuyU"
    }
  }
}
